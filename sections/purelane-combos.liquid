<section
  id="PurelaneCombos-{{ section.id }}"
  class="purelane-combos"
>
  <div class="purelane-combos__container">

    <!-- HEADER -->

    <div class="purelane-combos__header">

      <div class="purelane-combos__kicker">
        PRE-BUILT TO SAVE YOU MONEY
      </div>

      <h2 class="purelane-combos__heading">
        BEST SELLING COMBOS
      </h2>

      <div class="purelane-combos__divider">
        <span></span>
        <b>⌁</b>
        <span></span>
      </div>

      <p class="purelane-combos__description">
        Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.
      </p>

    </div>


    <!-- CAROUSEL -->

    <div
      class="purelane-combos__rail"
      data-combos-rail
    >

      <div
        class="purelane-combos__track"
        data-combos-track
      >

        {% for block in section.blocks %}

          {% assign product_1 = block.settings.product_1 %}
          {% assign product_2 = block.settings.product_2 %}
          {% assign product_3 = block.settings.product_3 %}

          {% assign original_price = 0 %}

          {% if product_1 != blank %}
            {% assign original_price = original_price | plus: product_1.price %}
          {% endif %}

          {% if product_2 != blank %}
            {% assign original_price = original_price | plus: product_2.price %}
          {% endif %}

          {% if product_3 != blank %}
            {% assign original_price = original_price | plus: product_3.price %}
          {% endif %}

          {% assign combo_price_paise = block.settings.combo_price | times: 100 %}
          {% assign savings = original_price | minus: combo_price_paise %}

          {% assign product_count = 0 %}

          {% if product_1 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}

          {% if product_2 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}

          {% if product_3 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}


          <article
            class="purelane-combo-card {% if block.settings.featured %}purelane-combo-card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >

            <!-- BADGES -->

            <div class="purelane-combo-card__badges">

              {% if block.settings.savings_label != blank %}
                <span class="purelane-combo-card__saving-badge">
                  {{ block.settings.savings_label }}
                </span>
              {% endif %}

              {% if block.settings.featured and block.settings.featured_label != blank %}
                <span class="purelane-combo-card__featured-badge">
                  {{ block.settings.featured_label }}
                </span>
              {% endif %}

            </div>


            <!-- PRODUCTS -->

            <div class="purelane-combo-card__products">

              {% if product_1 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_1.featured_image %}
                      {{
                        product_1.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_1.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_1.title }}
                  </div>

                </div>

              {% endif %}


              {% if product_1 != blank and product_2 != blank %}
                <span class="purelane-combo-plus">+</span>
              {% endif %}


              {% if product_2 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_2.featured_image %}
                      {{
                        product_2.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_2.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_2.title }}
                  </div>

                </div>

              {% endif %}


              {% if product_2 != blank and product_3 != blank %}
                <span class="purelane-combo-plus">+</span>
              {% endif %}


              {% if product_3 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_3.featured_image %}
                      {{
                        product_3.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_3.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_3.title }}
                  </div>

                </div>

              {% endif %}

            </div>


            <!-- CARD BODY -->

            <div class="purelane-combo-card__body">

              <h3>
                {{ block.settings.title }}
              </h3>

              <div class="purelane-combo-card__count">
                {{ product_count }} PRODUCTS
              </div>

              <p class="purelane-combo-card__description">
                {{ block.settings.description }}
              </p>


              <!-- PRICE -->

              <div class="purelane-combo-card__price-row">

                <strong>
                  {{ combo_price_paise | money }}
                </strong>

                {% if original_price > combo_price_paise %}
                  <del>
                    {{ original_price | money }}
                  </del>
                {% endif %}

                {% if savings > 0 %}
                  <span class="purelane-combo-card__save">
                    SAVE {{ savings | money }}
                  </span>
                {% endif %}

              </div>


              <div class="purelane-combo-card__meta">
                Inclusive of all taxes · COD available
              </div>


              <!-- BUTTON -->

              {% if block.settings.button_link != blank %}

                <a
                  href="{{ block.settings.button_link }}"
                  class="purelane-combo-card__button"
                >
                  {{ block.settings.button_label }}
                  <span>→</span>
                </a>

              {% else %}

                <div class="purelane-combo-card__button">
                  {{ block.settings.button_label }}
                  <span>→</span>
                </div>

              {% endif %}

            </div>

          </article>

        {% endfor %}


        <!-- DUPLICATE SET FOR LOOP -->

        {% for block in section.blocks %}

          {% assign product_1 = block.settings.product_1 %}
          {% assign product_2 = block.settings.product_2 %}
          {% assign product_3 = block.settings.product_3 %}

          {% assign original_price = 0 %}

          {% if product_1 != blank %}
            {% assign original_price = original_price | plus: product_1.price %}
          {% endif %}

          {% if product_2 != blank %}
            {% assign original_price = original_price | plus: product_2.price %}
          {% endif %}

          {% if product_3 != blank %}
            {% assign original_price = original_price | plus: product_3.price %}
          {% endif %}

          {% assign combo_price_paise = block.settings.combo_price | times: 100 %}
          {% assign savings = original_price | minus: combo_price_paise %}

          {% assign product_count = 0 %}

          {% if product_1 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}

          {% if product_2 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}

          {% if product_3 != blank %}
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}


          <article
            class="purelane-combo-card {% if block.settings.featured %}purelane-combo-card--featured{% endif %}"
            aria-hidden="true"
          >

            <div class="purelane-combo-card__badges">

              {% if block.settings.savings_label != blank %}
                <span class="purelane-combo-card__saving-badge">
                  {{ block.settings.savings_label }}
                </span>
              {% endif %}

              {% if block.settings.featured and block.settings.featured_label != blank %}
                <span class="purelane-combo-card__featured-badge">
                  {{ block.settings.featured_label }}
                </span>
              {% endif %}

            </div>


            <div class="purelane-combo-card__products">

              {% if product_1 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_1.featured_image %}
                      {{
                        product_1.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_1.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_1.title }}
                  </div>

                </div>

              {% endif %}


              {% if product_1 != blank and product_2 != blank %}
                <span class="purelane-combo-plus">+</span>
              {% endif %}


              {% if product_2 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_2.featured_image %}
                      {{
                        product_2.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_2.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_2.title }}
                  </div>

                </div>

              {% endif %}


              {% if product_2 != blank and product_3 != blank %}
                <span class="purelane-combo-plus">+</span>
              {% endif %}


              {% if product_3 != blank %}

                <div class="purelane-combo-product">

                  <div class="purelane-combo-product__image">

                    {% if product_3.featured_image %}
                      {{
                        product_3.featured_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: product_3.title
                      }}
                    {% endif %}

                  </div>

                  <div class="purelane-combo-product__name">
                    {{ product_3.title }}
                  </div>

                </div>

              {% endif %}

            </div>


            <div class="purelane-combo-card__body">

              <h3>
                {{ block.settings.title }}
              </h3>

              <div class="purelane-combo-card__count">
                {{ product_count }} PRODUCTS
              </div>

              <p class="purelane-combo-card__description">
                {{ block.settings.description }}
              </p>


              <div class="purelane-combo-card__price-row">

                <strong>
                  {{ combo_price_paise | money }}
                </strong>

                {% if original_price > combo_price_paise %}
                  <del>
                    {{ original_price | money }}
                  </del>
                {% endif %}

                {% if savings > 0 %}
                  <span class="purelane-combo-card__save">
                    SAVE {{ savings | money }}
                  </span>
                {% endif %}

              </div>


              <div class="purelane-combo-card__meta">
                Inclusive of all taxes · COD available
              </div>


              <div class="purelane-combo-card__button">
                {{ block.settings.button_label }}
                <span>→</span>
              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    </div>


    <!-- SWIPE LABEL -->

    <div class="purelane-combos__swipe">
      <span>→</span>
      SWIPE FOR MORE COMBOS
      <span>→</span>
    </div>

  </div>
</section>


<style>

.purelane-combos {
  width: 100%;
  overflow: hidden;

  padding: 42px 0 28px;

  background:
    linear-gradient(
      180deg,
      #dff5e5 0%,
      #c8ebd5 50%,
      #b9dfc9 100%
    );
}

.purelane-combos__container {
  width: 100%;
  margin: 0 auto;
}


/* HEADER */

.purelane-combos__header {
  max-width: 820px;

  margin: 0 auto 30px;
  padding: 0 20px;

  text-align: center;
}

.purelane-combos__kicker {
  margin-bottom: 14px;

  color: #77728b;

  font-size: 12px;
  font-weight: 800;
  letter-spacing: .20em;
  line-height: 1;

  text-transform: uppercase;
}

.purelane-combos__heading {
  margin: 0;

  color: #17132f;

  font-size: clamp(40px, 5vw, 58px);
  font-weight: 900;
  line-height: .98;
  letter-spacing: -.035em;

  text-transform: uppercase;
}

.purelane-combos__divider {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 16px;

  max-width: 180px;

  margin: 18px auto;
}

.purelane-combos__divider span {
  flex: 1;

  height: 1px;

  background: rgba(77,91,103,.25);
}

.purelane-combos__divider b {
  color: #d58a25;

  font-size: 18px;
  font-weight: 400;
}

.purelane-combos__description {
  max-width: 620px;

  margin: 0 auto;

  color: #5b5770;

  font-size: 17px;
  line-height: 1.55;
}


/* CUSTOMER SWIPE RAIL */

.purelane-combos__rail {
  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  padding-bottom: 8px;

  cursor: grab;

  scrollbar-width: none;

  -webkit-overflow-scrolling: touch;

  touch-action: pan-x;

  overscroll-behavior-x: contain;
}

.purelane-combos__rail::-webkit-scrollbar {
  display: none;
}

.purelane-combos__rail.is-dragging {
  cursor: grabbing;
}

.purelane-combos__track {
  display: flex;

  width: max-content;

  gap: 18px;

  padding: 0 18px;
}


/* CARD */

.purelane-combo-card {
  position: relative;

  flex: 0 0 320px;

  width: 320px;
  min-height: 470px;

  overflow: hidden;

  border-radius: 25px;

  background:
    linear-gradient(
      180deg,
      rgba(250,252,251,.92),
      rgba(225,243,234,.90)
    );

  border: 1px solid rgba(255,255,255,.85);

  box-shadow:
    0 12px 30px rgba(30,80,50,.10);

  user-select: none;
}

.purelane-combo-card--featured {
  border: 2px solid rgba(210,151,64,.65);
}


/* BADGES */

.purelane-combo-card__badges {
  position: absolute;

  z-index: 3;

  top: 15px;
  left: 15px;
  right: 15px;

  display: flex;

  justify-content: space-between;

  gap: 8px;
}

.purelane-combo-card__saving-badge,
.purelane-combo-card__featured-badge {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 28px;

  padding: 6px 11px;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;

  text-transform: uppercase;

  white-space: nowrap;
}

.purelane-combo-card__saving-badge {
  color: #71993c;

  background: rgba(255,255,255,.9);

  border: 1px solid #bfd69f;
}

.purelane-combo-card__featured-badge {
  color: #fff;

  background: #08796f;
}


/* PRODUCT AREA */

.purelane-combo-card__products {
  display: flex;

  align-items: flex-start;
  justify-content: center;

  gap: 6px;

  height: 178px;

  padding: 48px 12px 8px;

  box-sizing: border-box;

  background:
    linear-gradient(
      180deg,
      rgba(238,248,243,.95),
      rgba(224,240,233,.75)
    );

  border-bottom: 1px solid rgba(125,150,140,.18);
}

.purelane-combo-product {
  flex: 1 1 0;

  min-width: 0;

  text-align: center;
}

.purelane-combo-product__image {
  display: flex;

  align-items: center;
  justify-content: center;

  height: 92px;
}

.purelane-combo-product__image img {
  display: block;

  width: auto;

  max-width: 78px;

  height: 88px;

  object-fit: contain;

  pointer-events: none;
}

.purelane-combo-product__name {
  margin-top: 4px;

  color: #5f5a70;

  font-size: 9px;
  font-weight: 700;

  line-height: 1.2;
}

.purelane-combo-plus {
  flex: 0 0 auto;

  margin-top: 40px;

  color: #d98c22;

  font-size: 19px;
  font-weight: 800;
}


/* BODY */

.purelane-combo-card__body {
  padding: 17px;
}

.purelane-combo-card__body h3 {
  margin: 0 0 6px;

  color: #1b1732;

  font-size: 18px;
  font-weight: 900;

  line-height: 1.15;

  text-transform: uppercase;
}

.purelane-combo-card__count {
  margin-bottom: 11px;

  color: #817c91;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .16em;
}

.purelane-combo-card__description {
  min-height: 67px;

  margin: 0 0 13px;

  color: #5e5a71;

  font-size: 12.5px;

  line-height: 1.45;
}


/* PRICE */

.purelane-combo-card__price-row {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 7px;

  margin-bottom: 8px;
}

.purelane-combo-card__price-row strong {
  color: #17132f;

  font-size: 25px;
  font-weight: 900;
}

.purelane-combo-card__price-row del {
  color: #777484;

  font-size: 12px;
}

.purelane-combo-card__save {
  padding: 5px 8px;

  border-radius: 999px;

  color: #679039;

  background: #e6efcf;

  font-size: 9px;
  font-weight: 800;

  text-transform: uppercase;
}

.purelane-combo-card__meta {
  margin-bottom: 13px;

  color: #777486;

  font-size: 10px;
}


/* BUTTON */

.purelane-combo-card__button {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 9px;

  width: 100%;
  min-height: 45px;

  box-sizing: border-box;

  border-radius: 999px;

  background: #08796f;

  color: #fff;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: .14em;

  text-decoration: none;

  text-transform: uppercase;
}

.purelane-combo-card__button span {
  font-size: 18px;
}


/* SWIPE INDICATOR */

.purelane-combos__swipe {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  margin-top: 16px;

  color: #777486;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.purelane-combos__swipe span {
  color: #d88c25;

  font-size: 15px;
}


/* MOBILE */

@media (max-width: 760px) {

  .purelane-combos {
    padding: 34px 0 24px;
  }

  .purelane-combos__heading {
    font-size: 36px;
  }

  .purelane-combos__description {
    font-size: 14px;
  }

  .purelane-combo-card {
    flex-basis: 285px;

    width: 285px;

    min-height: 450px;
  }

  .purelane-combos__track {
    gap: 12px;

    padding-left: 12px;
    padding-right: 12px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  .purelane-combos__rail {
    scroll-behavior: auto;
  }

}

</style>


<script>
(function () {

  function initPurelaneCombos(section) {

    const rail = section.querySelector('[data-combos-rail]');
    const track = section.querySelector('[data-combos-track]');

    if (!rail || !track) return;

    if (rail.dataset.initialized === 'true') return;

    rail.dataset.initialized = 'true';


    let autoScroll = true;
    let dragging = false;

    let startX = 0;
    let startScrollLeft = 0;

    let resumeTimer = null;
    let animationFrame = null;

    const speed = 0.45;


    /*
     * AUTO SCROLL
     */

    function animate() {

      if (autoScroll && !dragging) {

        rail.scrollLeft += speed;

        /*
         * Because the second set of cards is a duplicate
         * of the first set, reset back by half the track
         * when we reach the duplicated section.
         */

        const halfway =
          (track.scrollWidth - rail.clientWidth) / 2;

        if (
          halfway > 0 &&
          rail.scrollLeft >= halfway
        ) {
          rail.scrollLeft = 0;
        }

      }

      animationFrame =
        requestAnimationFrame(animate);
    }


    animate();


    /*
     * PAUSE AUTO SCROLL
     */

    function pauseAutoScroll() {

      autoScroll = false;

      clearTimeout(resumeTimer);

      resumeTimer = setTimeout(function () {

        if (!dragging) {
          autoScroll = true;
        }

      }, 2200);

    }


    /*
     * MOUSE / TRACKPAD DRAG
     */

    rail.addEventListener(
      'pointerdown',
      function (event) {

        dragging = true;

        autoScroll = false;

        clearTimeout(resumeTimer);

        startX = event.clientX;

        startScrollLeft = rail.scrollLeft;

        rail.classList.add('is-dragging');

        rail.setPointerCapture(event.pointerId);

      }
    );


    rail.addEventListener(
      'pointermove',
      function (event) {

        if (!dragging) return;

        const distance =
          event.clientX - startX;

        rail.scrollLeft =
          startScrollLeft - distance;

      }
    );


    function stopDragging() {

      if (!dragging) return;

      dragging = false;

      rail.classList.remove('is-dragging');

      clearTimeout(resumeTimer);

      resumeTimer = setTimeout(function () {
        autoScroll = true;
      }, 1800);

    }


    rail.addEventListener(
      'pointerup',
      stopDragging
    );

    rail.addEventListener(
      'pointercancel',
      stopDragging
    );


    /*
     * NORMAL TOUCH SWIPING
     *
     * Native touch scrolling remains enabled.
     * This simply pauses the automatic movement
     * while the customer is interacting.
     */

    rail.addEventListener(
      'touchstart',
      function () {

        pauseAutoScroll();

      },
      {
        passive: true
      }
    );


    rail.addEventListener(
      'touchmove',
      function () {

        pauseAutoScroll();

      },
      {
        passive: true
      }
    );


    rail.addEventListener(
      'wheel',
      function () {

        pauseAutoScroll();

      },
      {
        passive: true
      }
    );


    /*
     * MOUSE HOVER
     */

    rail.addEventListener(
      'mouseenter',
      function () {

        autoScroll = false;

      }
    );


    rail.addEventListener(
      'mouseleave',
      function () {

        if (!dragging) {

          clearTimeout(resumeTimer);

          resumeTimer = setTimeout(
            function () {
              autoScroll = true;
            },
            1000
          );

        }

      }
    );

  }


  function initAll() {

    const sections =
      document.querySelectorAll(
        '[id^="PurelaneCombos-"]'
      );

    sections.forEach(initPurelaneCombos);

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initAll
    );

  } else {

    initAll();

  }


  /*
   * Shopify Theme Editor support
   */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      const section =
        document.getElementById(
          'PurelaneCombos-' + event.detail.sectionId
        );

      if (section) {
        initPurelaneCombos(section);
      }

    }
  );

})();
</script>


{% schema %}

{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",

  "settings": [],

  "blocks": [

    {
      "type": "combo",
      "name": "Combo",

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Kitchen essentials"
        },

        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },

        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },

        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes the essentials you need for a sparkling clean home."
