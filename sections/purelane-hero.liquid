<section class="purelane-hero" id="PurelaneHero-{{ section.id }}">
  <div class="purelane-hero__inner">

    <div class="purelane-hero__promises" aria-label="Product promises">
      <div class="purelane-hero__promise">
        <span class="purelane-hero__icon" aria-hidden="true">⌁</span>
        <span>{{ section.settings.promise_1 }}</span>
      </div>
      <div class="purelane-hero__promise">
        <span class="purelane-hero__icon" aria-hidden="true">✓</span>
        <span>{{ section.settings.promise_2 }}</span>
      </div>
      <div class="purelane-hero__promise">
        <span class="purelane-hero__icon" aria-hidden="true">◯</span>
        <span>{{ section.settings.promise_3 }}</span>
      </div>
    </div>

    <div class="purelane-hero__copy">
      <h1 class="purelane-hero__heading">
        {{ section.settings.heading_line_1 }}<br>
        {{ section.settings.heading_line_2 }}<br>
        <span>{{ section.settings.heading_line_3 }}</span>
      </h1>

      <div class="purelane-hero__rule" aria-hidden="true">
        <i></i><span>⌁</span><i></i>
      </div>

      <div class="purelane-hero__description">{{ section.settings.description }}</div>

      <div class="purelane-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a href="{{ section.settings.primary_link | default: '#shop' }}" class="purelane-hero__button purelane-hero__button--primary">
            {{ section.settings.primary_label }}<span aria-hidden="true">→</span>
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a href="{{ section.settings.secondary_link | default: '#how' }}" class="purelane-hero__button purelane-hero__button--secondary">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>

      <div class="purelane-hero__mobile-promises">
        <div><span aria-hidden="true">⌁</span>{{ section.settings.promise_1 }}</div>
        <div><span aria-hidden="true">✓</span>{{ section.settings.promise_2 }}</div>
        <div><span aria-hidden="true">◯</span>{{ section.settings.promise_3 }}</div>
      </div>
    </div>

    <div class="purelane-hero__product" aria-label="Purelane product offers">
      <div class="purelane-hero__stage" data-purelane-stage>

        <div class="purelane-hero__slide is-active" data-slide="1">
          <span class="purelane-hero__bottle purelane-hero__bottle--kitchen d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="purelane-hero__price glass-2">
            <span class="label">{{ section.settings.offer_1_label }}</span>
            {% assign kitchen = section.settings.kitchen_product %}
            <div class="value">
              {% if kitchen != blank %}<strong>{{ kitchen.price | money }}</strong>{% else %}<strong>{{ section.settings.offer_1_price }}</strong>{% endif %}
              {% if kitchen != blank and kitchen.compare_at_price > kitchen.price %}<s>{{ kitchen.compare_at_price | money }}</s>{% else %}{% if section.settings.offer_1_compare != blank %}<s>{{ section.settings.offer_1_compare }}</s>{% endif %}{% endif %}
            </div>
            <span class="cut">{{ section.settings.offer_1_badge }}</span>
          </div>
        </div>

        <div class="purelane-hero__slide" data-slide="2">
          <span class="purelane-hero__bottle purelane-hero__bottle--tap d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
          <span class="purelane-hero__bottle purelane-hero__bottle--kitchen-2 d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="purelane-hero__price glass-2">
            <span class="label">{{ section.settings.offer_2_label }}</span>
            <div class="value"><strong>{{ section.settings.offer_2_price }}</strong><s>{{ section.settings.offer_2_compare }}</s></div>
            <span class="cut">{{ section.settings.offer_2_badge }}</span>
          </div>
        </div>

        <div class="purelane-hero__slide" data-slide="3">
          <span class="purelane-hero__bottle purelane-hero__bottle--tap-3 d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
          <span class="purelane-hero__bottle purelane-hero__bottle--metal d2" role="img" aria-label="Purelane copper bronze and brass cleaner pump bottle"></span>
          <span class="purelane-hero__bottle purelane-hero__bottle--kitchen-3 d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="purelane-hero__price glass-2">
            <span class="label">{{ section.settings.offer_3_label }}</span>
            <div class="value"><strong>{{ section.settings.offer_3_price }}</strong><s>{{ section.settings.offer_3_compare }}</s></div>
            <span class="cut">{{ section.settings.offer_3_badge }}</span>
          </div>
        </div>
      </div>

      <div class="purelane-hero__dots" data-purelane-dots>
        <button type="button" class="is-active" data-slide-button="0" aria-label="Show 1 product"></button>
        <button type="button" data-slide-button="1" aria-label="Show 2 products"></button>
        <button type="button" data-slide-button="2" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

<style>
  #PurelaneHero-{{ section.id }} {
    --ink:#17102b;
    --deep:#241a3d;
    --brand:#4b3a8f;
    --brand-lt:#6b55b8;
    --paper:#ece6f7;
    --paper-2:rgba(236,230,247,.74);
    --paper-3:rgba(236,230,247,.52);
    --accent:#f0a03c;
    --surface:#faf7fd;
    --ease:cubic-bezier(.2,.7,.2,1);

    position:relative;
    z-index:2;
    min-height:100svh;
    display:flex;
    align-items:flex-end;
    overflow:hidden;
    padding:150px 0 34px; 

    color:var(--ink);

    background:
      linear-gradient(
        105deg,
        #f3fbf6 0%,
        #e7f7ed 45%,
        #d9f2e3 100%
      );
  }

  #PurelaneHero-{{ section.id }}::before {
    content:"";
    position:absolute;
    inset:0;
    z-index:1;
    pointer-events:none;
    background:
      radial-gradient(
        circle at 72% 40%,
        rgba(190,238,205,.55),
        transparent 48%
      );
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__inner {
    max-width:1180px; margin:0 auto; padding:0 18px; width:100%; position:relative; z-index:2;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__copy { max-width:600px; position:relative; z-index:3; }

  #PurelaneHero-{{ section.id }} .purelane-hero__heading {
    margin:0 0 20px; font-family:Outfit,system-ui,sans-serif; font-size:clamp(48px,8.6vw,112px);
    line-height:.87; font-weight:800; letter-spacing:-.018em; color:var(--ink);
    text-transform:uppercase; text-shadow:none;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__heading span { color:#f0a03c; }

  #PurelaneHero-{{ section.id }} .purelane-hero__rule {
    display:flex;align-items:center;gap:13px;margin:0 0 20px;max-width:270px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__rule i {
    height:1px;flex:1;background:linear-gradient(90deg,rgba(236,230,247,.44),transparent);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__rule span {
    color:var(--accent);font-size:16px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__description {
    max-width:600px;color:#4f4a69;font-size:16px;line-height:1.7;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__description p { margin:0; }

  #PurelaneHero-{{ section.id }} .purelane-hero__actions {
    display:flex;gap:11px;flex-wrap:wrap;margin-top:26px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__button {
    display:inline-flex;align-items:center;gap:12px;min-height:50px;padding:0 24px;border-radius:999px;
    text-decoration:none;font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__button--primary {
    background:#f0a03c;color:#17102b;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__button--secondary {
    background:rgba(236,230,247,.10);color:var(--surface);border:1px solid rgba(236,230,247,.22);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__product {
    position:absolute;right:2%;bottom:28px;width:min(50vw,560px);z-index:2;
    filter:drop-shadow(0 34px 54px rgba(2,20,19,.6));
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__stage {
    position:relative;width:100%;height:clamp(380px,74svh,680px);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__slide {
    position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;padding-right:2%;opacity:0;
    pointer-events:none;transition:opacity .85s var(--ease);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active { opacity:1; }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle {
    position:relative;width:auto;flex:0 0 auto;background-repeat:no-repeat;background-position:center bottom;background-size:contain;
    opacity:0;transform:translateY(28px) scale(.94);transition:opacity .8s var(--ease),transform .8s var(--ease);
    filter:drop-shadow(0 26px 40px rgba(1,22,20,.66));
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__bottle {
    opacity:1;transform:none;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active .d1 { transition-delay:.06s; }
  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active .d2 { transition-delay:.30s; }
  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active .d3 { transition-delay:.54s; }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--kitchen {
    height:100%;z-index:3;aspect-ratio:.3229;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--tap {
    height:80%;margin-right:-8%;z-index:1;aspect-ratio:.322;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--kitchen-2 {
    height:97%;z-index:3;aspect-ratio:.3229;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--tap-3 {
    height:75%;margin-right:-8%;z-index:1;order:1;aspect-ratio:.322;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--metal {
    height:79%;margin-left:-8%;z-index:2;order:3;aspect-ratio:.3416;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__bottle--kitchen-3 {
    height:97%;z-index:3;order:2;aspect-ratio:.3229;background-image:url("data:image/svg+xml;base64,");
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price {
    position:absolute;left:0;bottom:2%;z-index:6;padding:11px 14px 12px;border-radius:16px;max-width:52%;
    background:linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));
    border:1px solid rgba(236,230,247,.22);box-shadow:0 26px 74px rgba(18,12,34,.44),inset 0 1px 0 rgba(255,255,255,.24);
    backdrop-filter:blur(12px);opacity:0;transform:translateY(16px);transition:opacity .8s var(--ease) .62s,transform .8s var(--ease) .62s;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__price {
    opacity:1;transform:none;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price .label {
    display:block;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:var(--accent);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price .value {
    display:flex;align-items:baseline;gap:7px;margin-top:5px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price strong {
    font-family:Outfit,sans-serif;font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--surface);line-height:1;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price s {
    font-size:12px;color:var(--paper-3);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__price .cut {
    display:inline-block;margin-top:7px;font-size:8.4px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;
    padding:3px 8px;border-radius:999px;background:rgba(240,160,60,.20);
    border:1px solid rgba(240,160,60,.38);color:var(--accent);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__dots {
    display:flex;gap:7px;justify-content:center;align-items:center;margin-top:8px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__dots button {
    width:6px;height:6px;padding:0;border-radius:50%;background:rgba(236,230,247,.28);transition:.4s var(--ease);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__dots button.is-active {
    background:var(--accent);width:20px;border-radius:999px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__promises {
    position:absolute;right:18px;top:50%;transform:translateY(-50%);width:96px;z-index:4;display:flex;flex-direction:column;gap:2px;
    padding:12px 8px;border-radius:20px;background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);backdrop-filter:blur(12px);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__promise {
    text-align:center;padding:11px 4px;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__promise + .purelane-hero__promise {
    border-top:1px solid rgba(236,230,247,.14);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__icon {
    width:38px;height:38px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;
    background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);color:var(--accent);
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__promise > span:last-child {
    display:block;font-size:8.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;
    color:var(--paper-2);line-height:1.34;
  }

  #PurelaneHero-{{ section.id }} .purelane-hero__mobile-promises {
    display:none;
  }

  @media(max-width:1200px){
    #PurelaneHero-{{ section.id }} .purelane-hero__copy{max-width:470px}
    #PurelaneHero-{{ section.id }} .purelane-hero__product{width:min(44vw,440px);right:3%}
  }

  @media(max-width:900px){
    #PurelaneHero-{{ section.id }}{padding-top:132px}

    #PurelaneHero-{{ section.id }}::before{
      background:linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%)
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__copy{max-width:none}
    #PurelaneHero-{{ section.id }} .purelane-hero__promises{display:none}

    #PurelaneHero-{{ section.id }} .purelane-hero__product{
      position:relative;right:auto;bottom:auto;width:min(88vw,420px);margin:20px auto 0
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__stage{
      height:clamp(300px,44svh,430px)
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__price{
      padding:9px 12px 10px;border-radius:14px;max-width:58%
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__price strong{
      font-size:20px
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__mobile-promises{
      display:flex;gap:8px;margin-top:24px
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__mobile-promises div{
      flex:1;text-align:center;padding:11px 6px;border-radius:14px;
      background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.18);
      font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
      color:var(--paper-2);line-height:1.3
    }

    #PurelaneHero-{{ section.id }} .purelane-hero__mobile-promises span{
      display:block;margin-bottom:6px;color:var(--accent)
    }
  }

  @media(prefers-reduced-motion:reduce){
    #PurelaneHero-{{ section.id }} .purelane-hero__slide,
    #PurelaneHero-{{ section.id }} .purelane-hero__bottle,
    #PurelaneHero-{{ section.id }} .purelane-hero__price{transition:none}
  }
</style>

<script>
(function() {
  var root = document.getElementById('PurelaneHero-{{ section.id }}');
  if (!root) return;

  var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
  var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-slide-button]'));
  var index = 0;
  var timer;

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goTo(next) {
    index = (next + slides.length) % slides.length;

    slides.forEach(function(slide, i) {
      slide.classList.toggle('is-active', i === index);
    });

    buttons.forEach(function(button, i) {
      button.classList.toggle('is-active', i === index);
      button.setAttribute('aria-current', i === index ? 'true' : 'false');
    });
  }

  function start() {
    if (reduceMotion || slides.length < 2) return;

    clearInterval(timer);

    timer = setInterval(function() {
      goTo(index + 1);
    }, 4200);
  }

  buttons.forEach(function(button, i) {
    button.addEventListener('click', function() {
      goTo(i);
      start();
    });
  });

  goTo(0);
  start();

  document.addEventListener('shopify:section:unload', function(event) {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      clearInterval(timer);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {"type":"text","id":"heading_line_1","label":"Heading line 1","default":"Clean"},
    {"type":"text","id":"heading_line_2","label":"Heading line 2","default":"That"},
    {"type":"text","id":"heading_line_3","label":"Heading line 3","default":"Lasts"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.</p>"},
    {"type":"text","id":"promise_1","label":"Promise 1","default":"Plant powered"},
    {"type":"text","id":"promise_2","label":"Promise 2","default":"Safe for kids & pets"},
    {"type":"text","id":"promise_3","label":"Promise 3","default":"Zero harsh chemicals"},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop now"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"How it works"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"header","content":"Hero products"},
    {"type":"product","id":"kitchen_product","label":"Kitchen cleaner product"},
    {"type":"product","id":"tap_product","label":"Tap cleaner product"},
    {"type":"product","id":"metal_product","label":"Copper, bronze & brass cleaner product"},
    {"type":"header","content":"Offer 1 — single bottle"},
    {"type":"text","id":"offer_1_label","label":"Label","default":"Single bottle"},
    {"type":"text","id":"offer_1_price","label":"Fallback price","default":"₹200"},
    {"type":"text","id":"offer_1_compare","label":"Fallback compare price","default":"₹299"},
    {"type":"text","id":"offer_1_badge","label":"Badge","default":"33% off"},
    {"type":"header","content":"Offer 2 — two products"},
    {"type":"text","id":"offer_2_label","label":"Label","default":"Any 2 products"},
    {"type":"text","id":"offer_2_price","label":"Price","default":"₹349"},
    {"type":"text","id":"offer_2_compare","label":"Compare price","default":"₹598"},
    {"type":"text","id":"offer_2_badge","label":"Badge","default":"Save ₹249"},
    {"type":"header","content":"Offer 3 — three products"},
    {"type":"text","id":"offer_3_label","label":"Label","default":"Any 3 products"},
    {"type":"text","id":"offer_3_price","label":"Price","default":"₹499"},
    {"type":"text","id":"offer_3_compare","label":"Compare price","default":"₹897"},
    {"type":"text","id":"offer_3_badge","label":"Badge","default":"Save ₹398"}
  ],
  "presets": [{"name":"Purelane Hero"}]
}
{% endschema %}